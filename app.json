{
  "expo": {
    "name": "brainly_alarm_expo",
    "slug": "brainly-alarm-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brainlyalarmexpo",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.howeiay.brainlyalarm"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.howeiay.brainlyalarm"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.ttf",
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-SemiBold.ttf",
            "./assets/fonts/Geist-Bold.ttf"
          ]
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "./native/app.plugin.js",
      "./plugins/withCxxCleanFix.js",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3297f272-b465-4113-8a78-14fd2a5b7375"
      }
    },
    "owner": "howeiay"
  }
}
